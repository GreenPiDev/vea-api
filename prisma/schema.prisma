generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  VISITOR
  SELLER
  GALLERY_ADMIN
  SUPERADMIN
}

enum ArtworkCategory {
  PAINTING
  SCULPTURE
  PHOTOGRAPHY
  OTHER
}

enum ArtworkOrientation {
  PORTRAIT
  LANDSCAPE
  SQUARE
}

enum ArtworkConditionStatus {
  ORIGINAL
  RESTORED
  DAMAGED
  OTHER
}

enum ArtworkStatus {
  DRAFT
  LISTED
  IN_EXHIBITION
  SOLD
  ARCHIVED
}

enum ExhibitionStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  PAYMENT_HELD
  DELIVERED
  RELEASED
  CANCELLED
}

enum ArtistDecision {
  APPROVED
  REJECTED
}

enum RemovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
}

enum VisitEventType {
  EXHIBITION_ENTER
  ARTWORK_VIEW
  ARTWORK_VIEW_END
}

// ---------- Models ----------

model MarketingSource {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  users User[]
}

// A single firm's shared workspace. Only ADMIN users belong to one — every
// ADMIN in the same Organization manages the same pool of exhibitions (see
// Exhibition.organizationId below); VISITOR/ARTIST/SUPERADMIN never have one.
// SUPERADMIN is platform-level (us, the vendor), not scoped to any org — it
// creates Organizations and assigns ADMIN users to them.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  admins              User[]
  exhibitions         Exhibition[]
  exhibitionTemplates ExhibitionTemplate[]
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  phone             String?  @unique
  name              String?
  role              UserRole @default(VISITOR)
  organizationId    String?
  marketingSourceId String?
  createdAt         DateTime @default(now())

  organization           Organization?           @relation(fields: [organizationId], references: [id])
  marketingSource        MarketingSource?        @relation(fields: [marketingSourceId], references: [id])
  artistProfile          ArtistProfile?
  offers                 Offer[]
  verificationCodes      VerificationCode[]
  curatedExhibitions     Exhibition[]
  notifications          Notification[]
  removalRequestsMade    ArtworkRemovalRequest[] @relation("RemovalRequestedBy")
  removalRequestsDecided ArtworkRemovalRequest[] @relation("RemovalDecidedBy")

  @@index([marketingSourceId])
  @@index([organizationId])
}

// Generic, reusable notification record — not offer-specific. `type` is an
// open-ended string (same reasoning as Artwork.currency: the set of event
// types will keep growing as new features add notifications, and a Prisma
// enum would need a migration every time). `payload` carries whatever
// structured data the frontend needs to render a translated message — the
// backend never stores a pre-rendered string (this app has no hardcoded
// UI text anywhere, see vea-frontend/CLAUDE.md's i18n rule).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum VerificationChannel {
  EMAIL
  SMS
}

model VerificationCode {
  id         String              @id @default(cuid())
  userId     String
  channel    VerificationChannel @default(EMAIL)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, channel])
}

model ArtistProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  bio             String?
  institutionName String?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  artworks    Artwork[]
  exhibitions Exhibition[]
}

model Artwork {
  id                 String                 @id @default(cuid())
  artistProfileId    String
  title              String
  technique          String?
  yearCreated        Int?
  heightCm           Float
  widthCm            Float
  orientation        ArtworkOrientation
  /// Whether the artist's uploaded image already shows its own physical frame — false means the frontend renders a default modern-black frame mesh around the canvas in the 3D scene.
  framed             Boolean                @default(false)
  story              String?
  conditionStatus    ArtworkConditionStatus @default(ORIGINAL)
  conditionNotes     String?
  note               String?
  category           ArtworkCategory
  priceAmount        Int
  /// Artist-set cap (0-100, whole percent) on how far a buyer's offer may undercut priceAmount — null means no floor, any offer amount is accepted. Enforced in OffersService.create (minimum = priceAmount * (1 - maxDiscountPercent/100), rounded up) so it can't be bypassed by calling the API directly, not just a frontend UI hint.
  maxDiscountPercent Int?
  currency           String
  imageUrl           String
  model3dUrl         String?
  status             ArtworkStatus          @default(DRAFT)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  artistProfile   ArtistProfile           @relation(fields: [artistProfileId], references: [id])
  exhibitionLinks ExhibitionArtwork[]
  offers          Offer[]
  visitEvents     VisitEvent[]
  removalRequests ArtworkRemovalRequest[]

  @@index([artistProfileId])
  @@index([status])
}

model Exhibition {
  id                   String           @id @default(cuid())
  // Who literally clicked "create" — audit trail only. Management access
  // (GET /exhibitions/mine, update/status/delete/artwork placement) is
  // gated by organizationId below, not this field, so any ADMIN in the
  // same Organization can manage an exhibition regardless of who made it.
  curatorUserId        String
  organizationId       String?
  // Optional: the single artist this exhibition is curated around (a "solo"
  // show). Nullable so a curator can still create a mixed/group exhibition
  // with no pre-set artist, same as before this field existed — when unset,
  // the artwork placement screen offers every artist in the organization,
  // same as always. When set, it both pre-filters that screen to just this
  // artist's artworks and surfaces as a column in the curator's exhibition
  // table (see vea-frontend's ExhibitionForm.tsx/ExhibitionList.tsx).
  artistProfileId      String?
  // Set when sceneConfig.kind === 'template' AND templateId resolves to a
  // real ExhibitionTemplate row owned by this exhibition's organization —
  // lets a template's usage count be computed via a plain Prisma _count
  // (see ExhibitionTemplatesService.findOwn) instead of scanning sceneConfig
  // JSON. Null for the legacy static frontend templates (vea-frontend's
  // EXHIBITIONS registry, e.g. "renaissance") and for custom rooms.
  exhibitionTemplateId String?
  title                String
  description          String?
  startDate            DateTime
  endDate              DateTime
  status               ExhibitionStatus @default(DRAFT)
  sceneConfig          Json?
  maxArtworks          Int?
  createdAt            DateTime         @default(now())
  // Soft delete: set instead of a hard row delete so historical VisitEvent/
  // Offer/stats data tied to this exhibition (and its seller's own records)
  // survives a curator "removing" it. Null = active/visible; non-null =
  // excluded from public (findPublic/findOneForView) and, by default, from
  // the curator's own table (findOwn) — an explicit includeRemoved flag
  // brings it back for the "Kaldırılan sergileri göster" toggle. Stats
  // endpoints never filter on this, by design.
  deletedAt            DateTime?

  curator            User                    @relation(fields: [curatorUserId], references: [id])
  organization       Organization?           @relation(fields: [organizationId], references: [id])
  artistProfile      ArtistProfile?          @relation(fields: [artistProfileId], references: [id])
  exhibitionTemplate ExhibitionTemplate?     @relation(fields: [exhibitionTemplateId], references: [id])
  artworkLinks       ExhibitionArtwork[]
  visitEvents        VisitEvent[]
  removalRequests    ArtworkRemovalRequest[]

  @@index([curatorUserId])
  @@index([organizationId])
  @@index([artistProfileId])
  @@index([exhibitionTemplateId])
  @@index([status])
}

// A named, reusable room preset (size/wall height/color+texture theme) that
// an organization's admins can create and pick when creating an Exhibition
// (sceneConfig.kind:'template', templateId = this row's id) — the
// backend-driven counterpart to vea-frontend's static EXHIBITIONS registry
// (4 hardcoded rooms), which keeps working unchanged for legacy exhibitions.
// theme stores the full derived ExhibitionTheme (see vea-api's
// exhibition-templates/theme.ts, mirrored from vea-frontend's
// backendAdapter.ts buildCustomTheme()) so the frontend can render it
// exactly like a static EXHIBITIONS[].theme entry with no extra logic.
model ExhibitionTemplate {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  subtitle         String?
  // Discriminated union, same shape/spirit as Exhibition.sceneConfig:
  // {kind:'rectangle', width, depth} or {kind:'custom', cells:{x,z}[],
  // spawn:{x,z,yaw}} — see vea-api's exhibition-templates/dto/room-shape.dto.ts.
  // Opaque Json column (no migration for shape changes), validated at the
  // DTO layer.
  roomShape        Json
  wallHeight       Float
  wallColor        String
  floorColor       String
  ceilingColor     String
  floorTextureId   String?
  wallTextureId    String?
  ceilingTextureId String?
  theme            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  exhibitions  Exhibition[]

  @@index([organizationId])
}

model ExhibitionArtwork {
  id           String @id @default(cuid())
  exhibitionId String
  artworkId    String
  positionData Json?
  order        Int?

  exhibition Exhibition @relation(fields: [exhibitionId], references: [id])
  artwork    Artwork    @relation(fields: [artworkId], references: [id])

  @@unique([exhibitionId, artworkId])
  @@index([artworkId])
}

model Offer {
  id                  String          @id @default(cuid())
  artworkId           String
  buyerId             String
  amount              Int
  currency            String
  status              OfferStatus     @default(PENDING)
  // Informal, artist-facing signal — entirely separate from `status` above.
  // Setting this never touches the real accept/pay/deliver/release state
  // machine or PaymentService; it only lets the artist register a one-time,
  // irreversible preference that the org's admins can see. Null = no
  // decision yet.
  artistDecision      ArtistDecision?
  commissionAmount    Int?
  commissionTaxAmount Int?
  createdAt           DateTime        @default(now())
  respondedAt         DateTime?

  artwork     Artwork      @relation(fields: [artworkId], references: [id])
  buyer       User         @relation(fields: [buyerId], references: [id])
  transaction Transaction?

  @@index([artworkId])
  @@index([buyerId])
  @@index([status])
}

model Transaction {
  id          String            @id @default(cuid())
  offerId     String            @unique
  provider    String
  providerRef String?
  status      TransactionStatus @default(PENDING)
  heldAt      DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())

  offer Offer @relation(fields: [offerId], references: [id])
}

model VisitEvent {
  id           String         @id @default(cuid())
  exhibitionId String
  artworkId    String?
  sessionId    String
  eventType    VisitEventType
  durationMs   Int?
  occurredAt   DateTime       @default(now())

  exhibition Exhibition @relation(fields: [exhibitionId], references: [id])
  artwork    Artwork?   @relation(fields: [artworkId], references: [id])

  @@unique([artworkId, sessionId, eventType])
  @@index([exhibitionId, occurredAt])
  @@index([artworkId, occurredAt])
}

// Sanatçının, bir sergide sergilenmekte olan eserini silmek istediğinde açtığı
// küratör onayı gereken talep. Artwork.status'u doğrudan etkilemiyor —
// APPROVED olunca servis katmanı ExhibitionArtwork linkini kaldırıp Artwork'ü
// arşivliyor (bkz. ArtworkRemovalRequestsService).
model ArtworkRemovalRequest {
  id              String               @id @default(cuid())
  artworkId       String
  exhibitionId    String
  requestedById   String
  message         String
  status          RemovalRequestStatus @default(PENDING)
  responseMessage String?
  decidedById     String?
  createdAt       DateTime             @default(now())
  respondedAt     DateTime?

  artwork     Artwork    @relation(fields: [artworkId], references: [id])
  exhibition  Exhibition @relation(fields: [exhibitionId], references: [id])
  requestedBy User       @relation("RemovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?      @relation("RemovalDecidedBy", fields: [decidedById], references: [id])

  @@index([exhibitionId, status])
  @@index([artworkId, status])
}
