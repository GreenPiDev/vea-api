DATABASE_URL="postgresql://user:password@localhost:5432/vea_dev?schema=public"
PORT=3000
NODE_ENV=development

# openssl rand -hex 48
JWT_SECRET="change-me-to-a-long-random-value"
JWT_EXPIRES_IN="7d"

REDIS_URL="redis://localhost:6379"

# Comma-separated allowed frontend origins. Leave unset locally — defaults
# to http://localhost:5173 (Vite dev server).
CORS_ORIGIN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# This app's own base URL, used to build image links (/files?key=...)
# instead of R2's r2.dev domain. Leave unset locally — defaults to
# http://localhost:3000.
API_PUBLIC_URL=
